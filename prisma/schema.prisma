generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Transaccion {
  id              Int            @id @default(autoincrement())
  order_id        Int
  buyer_id        String
  seller_id       String
  monto_total     Float
  monto_acreditar Float
  estado          String         @default("pendiente")
  fecha           DateTime       @default(now())

  pagos           Pago[]
  acreditaciones  Acreditacion[]
  reclamos        Reclamo[]
}

model Pago {
  id             Int         @id @default(autoincrement())
  transaccion_id Int
  buyer_id       String
  monto          Float
  fecha          DateTime    @default(now())
  estado         String      @default("pendiente")

  transaccion    Transaccion @relation(fields: [transaccion_id], references: [id])
}

model Acreditacion {
  id             Int         @id @default(autoincrement())
  transaccion_id Int
  seller_id      String
  monto          Float
  fecha          DateTime    @default(now())
  estado         String      @default("pendiente")

  transaccion    Transaccion @relation(fields: [transaccion_id], references: [id])
}

model Reclamo {
  id                  Int         @id @default(autoincrement())
  transaccion_id      Int
  motivo              String
  estado              String      @default("abierto")
  fecha_apertura      DateTime    @default(now())
  fecha_resolucion    DateTime?
  monto_reembolso     Float?
  evidencia_comprador String?

  transaccion         Transaccion @relation(fields: [transaccion_id], references: [id])
}